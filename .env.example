# Copie para .env.local e preencha. NUNCA comite valores reais.
# Em produção, os valores ficam no painel da Vercel (Environment Variables).

# --- Supabase -----------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave de service role: SÓ SERVIDOR. Jamais renomear com prefixo NEXT_PUBLIC_,
# jamais importar em componente de cliente. O navegador não fala com o Supabase.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sessão e privacidade -----------------------------------------------------
# Segredo que assina o cookie httpOnly com o lead_id (32+ bytes aleatórios).
SESSAO_SECRET=

# Pepper do hash de IP guardado como prova de consentimento (32+ bytes).
IP_HASH_PEPPER=

# A versão da política NÃO é variável de ambiente: o texto da política mora no
# repositório, então a versão mora junto, em src/lib/consentimento.ts.

# --- Negócio ------------------------------------------------------------------
# Canal de atendimento LGPD (exclusão/correção) e contato geral, em E.164.
WHATSAPP_CONTATO=+5534900000000

# Integrador que recebe os leads que autorizaram compartilhamento. (tela 5)
PARCEIRO_SLUG=

# --- Infra --------------------------------------------------------------------
# Protege GET /api/cron/expurgo contra chamada de fora do cron. (a implementar)
CRON_SECRET=

# Usado para montar o link do relatório na mensagem de WhatsApp. (tela 5)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
